{
  "name": "@clerk/snapi",
  "version": "0.0.1",
  "description": "Snapi CLI",
  "type": "module",
  "bin": {
    "snapi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "snapi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.10.9",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@microsoft/api-extractor": "7.55.2",
    "commander": "14.0.2",
    "zod": "4.3.6"
  }
}
