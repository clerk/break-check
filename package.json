{
  "name": "@clerk/snapi",
  "version": "0.0.1",
  "description": "Snapi CLI",
  "type": "module",
  "bin": {
    "snapi": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "snapi"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
