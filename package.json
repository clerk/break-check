{
  "name": "@clerk/snapi",
  "version": "0.0.1",
  "description": "Snapi CLI",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "bin": {
    "snapi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "check": "pnpm check:format && pnpm typecheck && pnpm test && pnpm pack --dry-run",
    "check:format": "prettier --check .",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "prepare": "pnpm build",
    "release": "pnpm build && changeset publish",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "keywords": [
    "cli",
    "snapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clerk/snapi.git"
  },
  "bugs": {
    "url": "https://github.com/clerk/snapi/issues"
  },
  "homepage": "https://github.com/clerk/snapi#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "24.10.9",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@microsoft/api-extractor": "7.55.2",
    "commander": "14.0.2",
    "zod": "3.24.2"
  },
  "pnpm": {
    "overrides": {
      "ajv@<8.18.0": ">=8.18.0",
      "lodash@<4.18.0": ">=4.18.0",
      "minimatch@<10.2.3": ">=10.2.3"
    }
  }
}
