{
  "name": "@clerk/snapi",
  "version": "0.0.1",
  "description": "Snapi CLI",
  "type": "module",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "bin": {
    "snapi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "check": "pnpm check:format && pnpm typecheck && pnpm test && pnpm pack --dry-run",
    "check:format": "prettier --check .",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "prepare": "pnpm build",
    "release": "pnpm build && changeset publish",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "keywords": [
    "cli",
    "snapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clerk/snapi.git"
  },
  "bugs": {
    "url": "https://github.com/clerk/snapi/issues"
  },
  "homepage": "https://github.com/clerk/snapi#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "25.9.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.97.1",
    "@microsoft/api-extractor": "7.58.7",
    "commander": "14.0.3",
    "zod": "4.4.3"
  }
}
